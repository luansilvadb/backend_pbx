# 🚀 Backend PBX - Configurações de Ambiente
# Copie este arquivo para .env e ajuste as configurações conforme necessário

# ===========================================
# 🌐 CONFIGURAÇÕES DO SERVIDOR
# ===========================================

# Endereço e porta do servidor HTTP
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Nível de logging (trace, debug, info, warn, error)
LOG_LEVEL=info

# Formato de log (json, pretty)
LOG_FORMAT=pretty

# ===========================================
# 📡 CONFIGURAÇÕES DO FREESWITCH ESL
# ===========================================

# Host do FreeSWITCH ESL
FREESWITCH_HOST=127.0.0.1

# Porta do FreeSWITCH ESL
FREESWITCH_PORT=8021

# Senha de autenticação ESL
FREESWITCH_PASSWORD=ClueCon

# Timeout para operações ESL (segundos)
FREESWITCH_TIMEOUT=30

# Número máximo de tentativas de reconexão
FREESWITCH_MAX_RETRIES=5

# Intervalo entre tentativas de reconexão (segundos)
FREESWITCH_RETRY_INTERVAL=5

# ===========================================
# 🗄️ CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================

# URL de conexão do banco de dados
# Exemplos:
# PostgreSQL: postgresql://user:password@localhost/backend_pbx
# SQLite: sqlite://./backend_pbx.db
DATABASE_URL=sqlite://./backend_pbx.db

# Pool de conexões - tamanho máximo
DATABASE_MAX_CONNECTIONS=10

# Pool de conexões - timeout (segundos)
DATABASE_TIMEOUT=30

# ===========================================
# 🔐 CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# Chave secreta para JWT (gere uma chave forte em produção)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Tempo de expiração do JWT (em horas)
JWT_EXPIRATION=24

# Chave para criptografia de dados sensíveis
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# ===========================================
# 📊 CONFIGURAÇÕES DE MONITORAMENTO
# ===========================================

# Habilitar métricas Prometheus
METRICS_ENABLED=true

# Porta para métricas Prometheus
METRICS_PORT=9090

# Habilitar health checks
HEALTH_CHECK_ENABLED=true

# ===========================================
# 🏢 CONFIGURAÇÕES MULTI-TENANT
# ===========================================

# Diretório base para arquivos de tenants
TENANT_FILES_BASE_PATH=./tenant_files

# Diretório base para gravações
RECORDINGS_BASE_PATH=./recordings

# Limite padrão de chamadas simultâneas por tenant
DEFAULT_MAX_CONCURRENT_CALLS=10

# Limite padrão de ramais por tenant
DEFAULT_MAX_EXTENSIONS=50

# Limite padrão de minutos mensais por tenant
DEFAULT_MAX_MONTHLY_MINUTES=1000

# ===========================================
# 📧 CONFIGURAÇÕES DE NOTIFICAÇÕES
# ===========================================

# Configurações SMTP para envio de emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourcompany.com

# Webhook URL para notificações
WEBHOOK_URL=https://your-webhook-endpoint.com/notifications

# ===========================================
# 🔄 CONFIGURAÇÕES DE CACHE
# ===========================================

# URL do Redis para cache (opcional)
REDIS_URL=redis://127.0.0.1:6379

# TTL padrão para cache (segundos)
CACHE_TTL=3600

# ===========================================
# 🚀 CONFIGURAÇÕES DE AMBIENTE
# ===========================================

# Ambiente de execução (development, staging, production)
ENVIRONMENT=development

# Habilitar modo debug
DEBUG=true

# Habilitar CORS para desenvolvimento
CORS_ENABLED=true

# Domínios permitidos para CORS (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# 📁 CONFIGURAÇÕES DE ARQUIVOS
# ===========================================

# Diretório para upload de arquivos
UPLOAD_DIR=./uploads

# Tamanho máximo de upload (bytes)
MAX_UPLOAD_SIZE=10485760

# Tipos de arquivo permitidos (separados por vírgula)
ALLOWED_FILE_TYPES=wav,mp3,mp4,aac

# ===========================================
# 🔧 CONFIGURAÇÕES AVANÇADAS
# ===========================================

# Pool de workers para processamento assíncrono
WORKER_POOL_SIZE=4

# Tamanho do buffer de eventos ESL
EVENT_BUFFER_SIZE=10000

# Intervalo de heartbeat (segundos)
HEARTBEAT_INTERVAL=60

# Habilitar compressão de resposta HTTP
COMPRESSION_ENABLED=true

# ===========================================
# 🧪 CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===========================================

# Habilitar hot reload em desenvolvimento
HOT_RELOAD=true

# Porta do servidor de desenvolvimento
DEV_SERVER_PORT=3000

# Habilitar logs de SQL em desenvolvimento
SQL_LOGGING=false
