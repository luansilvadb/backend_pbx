# 🚀 Backend PBX - Git Ignore
# Arquivo para ignorar arquivos sensíveis e temporários

# ===========================================
# 📄 ARQUIVOS DE CONFIGURAÇÃO SENSÍVEIS
# ===========================================

# Arquivo .env contém credenciais - NUNCA commitar!
.env
.env.local
.env.production
.env.staging

# Manter apenas .env.example para referência
!.env.example

# ===========================================
# 🦀 RUST / CARGO
# ===========================================

# Build artifacts
/target/
**/*.rs.bk

# Cargo lock para binários (manter para libraries)
# Cargo.lock

# ===========================================
# 🗄️ BANCO DE DADOS
# ===========================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# PostgreSQL dumps
*.sql

# ===========================================
# 📁 ARQUIVOS TEMPORÁRIOS E LOGS
# ===========================================

# Diretórios de dados gerados
/tenant_files/
/recordings/
/uploads/
/logs/

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo
*~

# ===========================================
# 📊 MONITORAMENTO E MÉTRICAS
# ===========================================

# Arquivos de métricas
/metrics/
prometheus.yml

# ===========================================
# 🔐 SEGURANÇA
# ===========================================

# Chaves privadas
*.key
*.pem
*.p12
*.pfx

# Certificados
*.crt
*.cer

# ===========================================
# 💻 IDEs E EDITORES
# ===========================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ===========================================
# 🖥️ SISTEMAS OPERACIONAIS
# ===========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ===========================================
# 📦 DOCKER
# ===========================================

# Docker volumes
docker-compose.override.yml
.dockerignore

# ===========================================
# 🧪 TESTES E DESENVOLVIMENTO
# ===========================================

# Coverage reports
tarpaulin-report.html
cobertura.xml
lcov.info

# Benchmark results
/bench/

# Test artifacts
/test-results/

# ===========================================
# 📚 DOCUMENTAÇÃO GERADA
# ===========================================

# Rust docs (manter source docs)
/doc/

# OpenAPI gerado (se aplicável)
/api-docs/generated/

# ===========================================
# 🔧 CONFIGURAÇÕES LOCAIS
# ===========================================

# Configurações locais de desenvolvimento
config.local.yaml
config.dev.yaml

# Scripts locais
/scripts/local/

# ===========================================
# 💾 BACKUP E HISTÓRICO
# ===========================================

# Backups
*.bak
*.backup

# Patches
*.patch
*.diff

# ===========================================
# 🌐 WEB ASSETS (se aplicável)
# ===========================================

# Node modules (se frontend estiver incluído)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
/dist/
/build/

# ===========================================
# 📱 MOBILE (se aplicável)
# ===========================================

# Flutter/Dart
.dart_tool/
.packages
pubspec.lock

# ===========================================
# ☁️ CLOUD E INFRAESTRUTURA
# ===========================================

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Kubernetes
*.kubeconfig

# AWS
.aws/credentials

# ===========================================
# 🔄 CI/CD
# ===========================================

# Secrets para CI/CD (use secrets do repo)
.secrets
secrets.yaml

# ===========================================
# 📈 PERFORMANCE E PROFILING
# ===========================================

# Profiling data
*.prof
perf.data*
massif.out.*

# Flamegraph
flamegraph.svg

# ===========================================
# 🏷️ VERSIONAMENTO
# ===========================================

# Tags locais
.git/refs/tags/local-*

# Hooks locais
.git/hooks/local-*
